{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "X-MCP-Toolsets": "repos,issues,pull_requests" }
    },
    "magazzino": {
      "type": "http",
      "url": "http://localhost:8080/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--isolated"]
    },
    "spring-docs": {
      "type": "stdio",
      "command": "npx",
      "args": ["@enokdev/springdocs-mcp@latest"]
    },
  }
}
